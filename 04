#include <iostream>

using namespace std;
// 증감연산자
// 정수형에만 사용이 가능합니다.

int main() {
   int a = 20;

   ++a; // 전위식
   // a = a + 1;
   cout << "++a = " << a << endl;

   a++;   // 후위식
   // a = a + 1;
   cout << "a++ = " << a << endl;

   int c = ++a;
   // a = a + 1;
   // c = a;
   cout << "c = " << c << ", a = " << a << endl;

   c = a++;
   // c = a;
   // a = a + 1;
   cout << "c = " << c << ", a = " << a << endl;


   return 0;
}
