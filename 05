#include <iostream>

using namespace std;

// 대입연산자(할당연산자)

int main() {
   int k = 0;
   int j = 10;

   float m = 3.4f;

   k = 20;
   k = j;

   // 기본 데이타 타입간에는 
   // 컴파일러가 자동으로 형변환을 시켜 줍니다.

   k = m; // 컴파일러가 알아서 형변환을 하는 것을 묵시적 형변환이라고 합니다.
         // 실수 데이타 타입을 정수데이타 타입에 저장할때 묵시적 형변환을 하시면 안됩니다.

   k = (int)m;   // 명시적형변환

   cout << "k = " << k << endl;


   // 축약식

   k += 1;
   // k = k + 1;

   cout << "k = " << k << endl;

   k -= 1;
   // k = k - 1;
   cout << "k = " << k << endl;

   k *= 2;
   // k = k * 2;
   cout << "k = " << k << endl;



   return 0;
}
